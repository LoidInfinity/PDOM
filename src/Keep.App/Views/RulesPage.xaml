<UserControl x:Class="Keep.App.Views.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="34,26,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="守护规则" Style="{StaticResource PageTitle}" />
                <TextBlock Text="每条规则锁定一个默认打开方式；被改动时按设置自动还原" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="重新采集基准" Style="{StaticResource GhostButton}" Command="{Binding CaptureCommand}" />
                <Button Content="立即修复全部" Style="{StaticResource PrimaryButton}" Command="{Binding RepairAllCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchInput" Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="搜索扩展名、程序名称…" Foreground="#5B6A7D" FontSize="12.5"
                               Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChip}" Content="全部"
                                 GroupName="rulesFilter" IsChecked="True" Tag="all" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterProblem" Style="{StaticResource FilterChip}" Content="异常"
                                 GroupName="rulesFilter" Tag="problem" Checked="OnFilterChecked" />
                    <RadioButton x:Name="FilterBrowser" Style="{StaticResource FilterChip}" Content="浏览器"
                                 GroupName="rulesFilter" Tag="browser" Checked="OnFilterChecked" />
                </StackPanel>

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}">
                    <Run Text="共 " />
                    <Run Text="{Binding TotalRules, Mode=OneWay}" />
                    <Run Text=" 项" />
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="236" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="对象" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="期望程序" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="当前" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="守护" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding RulesView}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" Padding="18,9" CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#161E29" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="152" />
                                    <ColumnDefinition Width="236" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>

                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="7"
                                        BorderBrush="{Binding StatusBrush}" BorderThickness="1"
                                        Background="#101720" Padding="8,3">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10.5" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Target}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindText}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ProgId}" Style="{StaticResource MutedText}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding DetailText}" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

                                <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnToggleRule" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
