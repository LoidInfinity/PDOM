<UserControl x:Class="Keep.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="34,26,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="变更历史" Style="{StaticResource PageTitle}" />
                <TextBlock Text="每一次篡改、还原与拦截都会记录在这里" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="立即检测" Style="{StaticResource GhostButton}" Command="{Binding ScanCommand}" />
                <Button Content="清空记录" Style="{StaticResource GhostButton}" Command="{Binding ClearHistoryCommand}"
                        Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Padding="18,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="动作" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="对象" Style="{StaticResource MutedText}" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="变化" Style="{StaticResource MutedText}" FontSize="11" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" Padding="18,11" CornerRadius="8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#161E29" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}" FontSize="11.5"
                                           VerticalAlignment="Center" />

                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="7" Padding="8,3" Background="#101720"
                                        BorderThickness="1" BorderBrush="{Binding ActionBrush}">
                                    <TextBlock Text="{Binding ActionText}" Foreground="{Binding ActionBrush}" FontSize="10.5" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetText}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AppName}" Style="{StaticResource MutedText}" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChangeText}" Style="{StaticResource MutedText}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="10.5"
                                               Foreground="#6E7F96" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHistory}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="还没有任何变更记录" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="保持守护，这里会记录每一次拦截" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
