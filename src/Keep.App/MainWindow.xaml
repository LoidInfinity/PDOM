<Window x:Class="Keep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keep · 设置守护台"
        Width="1220" Height="820" MinWidth="1080" MinHeight="700"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid Margin="18,26,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentSoft}">
                        <Path Data="M12,2 L21,5.3 V11.4 C21,16.1 17.4,19.7 12,22 C6.6,19.7 3,16.1 3,11.4 V5.3 Z"
                              Fill="{StaticResource Accent}" Stretch="Uniform" Margin="10" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KEEP" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="设置守护台" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,38,0,0">
                    <TextBlock Text="工作台" FontSize="10" Foreground="#5B6A7D" Margin="18,0,0,8" />
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Content="总览"
                                 Tag="overview" IsChecked="True" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" Content="守护规则"
                                 Tag="rules" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Content="变更历史"
                                 Tag="history" Checked="OnNavChecked" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="设置"
                                 Tag="settings" Checked="OnNavChecked" />
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="12" Padding="13,11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="守护中" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="每" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding IntervalText}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0" />
                            <TextBlock Text="检测" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="守护" Style="{StaticResource MutedText}" FontSize="11" />
                            <TextBlock Text="{Binding TotalRules}" Style="{StaticResource MutedText}" FontSize="11" Margin="3,0" />
                            <TextBlock Text="项设置" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Ellipse Width="920" Height="540" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-240,-300,0,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#223DDC97" Offset="0" />
                        <GradientStop Color="#003DDC97" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
